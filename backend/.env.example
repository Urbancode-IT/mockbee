MONGO_URI=mongodb://localhost:27017
# Production (Linode): use Atlas or local Mongo, e.g.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/mockbee

# Bind address — behind nginx on Linode keep 127.0.0.1; direct expose use 0.0.0.0
HOST=127.0.0.1
PORT=8001

# Required for real AI chat / semantic evaluation (omit = demo/heuristic mode)
# Also powers the human-like interviewer voice (Gemini neural TTS)
GEMINI_API_KEY=
# Optional human voice: Aoede (default), Kore, Leda, Sulafat, Zephyr
GEMINI_TTS_VOICE=Aoede
GEMINI_TTS_MODEL=
# Primary neural voice (Microsoft Edge). en-IN-NeerjaNeural = clear Indian English.
# Alternatives: en-US-JennyNeural, en-GB-SoniaNeural, en-IN-PrabhatNeural
EDGE_TTS_VOICE=en-IN-NeerjaNeural

MOCKBEE_APP_NAME=MockBee
# Public frontend URL (emails / invite links)
MOCKBEE_APP_URL=https://your-frontend.example.com
MOCKBEE_ADMIN_USERNAME=admin
MOCKBEE_ADMIN_PASSWORD=change-me

EMAIL_PROVIDER=disabled
EMAIL_FROM=MockBee <noreply@example.com>
RESEND_API_KEY=

# Optional: scanned PDF OCR (requires: npm install tesseract.js)
PDF_OCR=0

# Optional future providers (fallback used when unset)
AVATAR_PROVIDER=fallback
AVATAR_API_KEY=
SPEECH_STT_PROVIDER=browser
SPEECH_TTS_PROVIDER=browser
SPEECH_STT_API_KEY=
SPEECH_TTS_API_KEY=
