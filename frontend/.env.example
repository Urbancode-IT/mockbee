# Empty = use Vite /api proxy in development
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# --- Vercel / production ---
# Set this in the Vercel project → Settings → Environment Variables
# (Production + Preview). Must be the public API origin, no trailing slash.
# Example:
# VITE_API_BASE=https://api.yourdomain.com
#
# After changing VITE_* vars, redeploy the frontend so the build picks them up.
